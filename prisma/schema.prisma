// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  savedSearches SavedSearch[]
  favorites     Favorite[]
  roadmaps      Roadmap[]
  // Career profile: shown on the profile page and used to pre-fill the roadmap form
  careerStatus     CareerStatus?
  targetRole       String?
  preferredCountry String?
  skills           String[]      @default([])
}

enum CareerStatus {
  STUDENT
  GRADUATE
  EMPLOYEE
}

enum Role {
  USER
  ADMIN
}

model Source {
  id      Int        @id @default(autoincrement())
  name    String     @unique
  type    SourceType
  country String
  offers  JobOffer[]
}

enum SourceType {
  SCRAPING
  API
}

model JobOffer {
  id        Int        @id @default(autoincrement())
  title     String
  company   String?
  country   String
  city      String?
  sector    String?
  skills    String[]
  salaryMin Int?
  salaryMax Int?
  postedAt  DateTime?
  validThrough DateTime? // application deadline, when the source gives one
  level     JobLevel? // who the offer is for; null when nothing says so
  isActive  Boolean   @default(true) // false once the offer is no longer in the latest import
  lastImportedAt DateTime? // start time of the last import run that contained this offer
  firstSeenAt DateTime @default(now()) // when the offer first appeared in an import (never updated)
  sourceId  Int
  source    Source     @relation(fields: [sourceId], references: [id])
  favorites Favorite[]
  externalId String
  url String?
  currency String?
  salaryPeriod SalaryPeriod?
  // Model estimate (tn-jobs salary-bracket model) for Tunisian offers that state no salary.
  // Same units as salaryMin/salaryMax (yearly, in estimatedSalaryCurrency); never mixed into them.
  estimatedSalaryBracket    String? // "<1000" | "1000-1500" | "1500-2000" | ">=2000" (TND / month)
  estimatedSalaryMin        Int?
  estimatedSalaryMax        Int?    // null for the open-ended ">=2000" bracket
  estimatedSalaryCurrency   String?
  estimatedSalaryConfidence Float?  // 0-1, the model's probability for that bracket
  @@unique([sourceId, externalId])
  @@index([country, city])
  @@index([sector])
  @@index([level])
  @@index([isActive, country])
  @@index([firstSeenAt])
}

model Favorite {
  userId     Int
  jobOfferId Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@id([userId, jobOfferId])
}

model SavedSearch {
  id            Int      @id @default(autoincrement())
  name          String
  filters       Json     // the jobs page filters (q, country, city, sector, skill, level)
  createdAt     DateTime @default(now())
  lastCheckedAt DateTime @default(now()) // offers imported after this count as "new"
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

enum SalaryPeriod {
  MONTH
  YEAR
}

model ExchangeRate {
  currency  String   @id
  perTnd    Float
  updatedAt DateTime @updatedAt
}

enum JobLevel {
  INTERNSHIP
  ENTRY
  EXPERIENCED
}

// AI career roadmaps. input = the profile the user entered, market = the facts computed from the
// job offers at generation time, plan = the roadmap written by the language model.
model Roadmap {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole String
  input      Json
  market     Json
  plan       Json
  model      String
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
}
